{
  "rules": {
    ".read": false,
    ".write": false,
    "lotes": {
      ".read": true,
      "$lote": {
        ".write": "auth != null && (!data.exists() || data.child('dono').val() === auth.uid)",
        ".validate": "$lote.matches(/^-?[0-9]{1,5}_-?[0-9]{1,5}$/) && newData.child('dono').val() === auth.uid && newData.child('nome').isString() && newData.child('nome').val().length <= 16 && (data.exists() || auth.uid === 'MyJ32756ZkMyoQiaboetnmrVPgr2' || newData.parent().parent().child('donos').child(auth.uid).child('s1').val() === $lote || newData.parent().parent().child('donos').child(auth.uid).child('s2').val() === $lote)",
        "dono": {
          ".validate": true
        },
        "nome": {
          ".validate": true
        },
        "$outro": {
          ".validate": false
        }
      }
    },
    "blocos": {
      ".read": true,
      "$lote": {
        ".write": "auth != null && root.child('lotes').child($lote).child('dono').val() === auth.uid",
        "$cel": {
          ".validate": "$cel.matches(/^([0-9]|1[01])_([0-9]|1[0-9]|2[0-3])_([0-9]|1[0-9])$/) && newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && ((newData.val() < 12) || (newData.val() >= 100 && newData.val() < 112))"
        }
      }
    },
    "visitas": {
      ".read": true,
      "$dia": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "$dia.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/) && newData.val() === true"
        }
      }
    },
    "donos": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$vaga": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "($vaga === 's1' || $vaga === 's2') && newData.isString() && newData.parent().parent().parent().child('lotes').child(newData.val()).child('dono').val() === auth.uid"
        }
      }
    },
    "negocios": {
      ".read": true,
      "$lote": {
        ".write": "auth != null && root.child('lotes').child($lote).child('dono').val() === auth.uid",
        ".validate": "newData.child('t').isString() && newData.child('t').val().matches(/^(padaria|lanchonete|mercado|roupas|farmacia|oficina|bar)$/) && newData.child('desde').isNumber()",
        "t": {
          ".validate": true
        },
        "desde": {
          ".validate": true
        },
        "$outro": {
          ".validate": false
        },
        "n": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        }
      }
    },
    "jornal": {
      ".read": true,
      ".indexOn": [
        "t"
      ],
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.child('uid').val() === auth.uid && newData.child('t').isNumber() && newData.child('t').val() <= now + 60000 && newData.child('t').val() >= now - 60000 && newData.child('tipo').isString() && newData.child('tipo').val().matches(/^(abriu|fechou|preso|surra|fugiu|terreno)$/) && newData.child('nome').isString() && newData.child('nome').val().length <= 16",
        "tipo": {
          ".validate": true
        },
        "nome": {
          ".validate": true
        },
        "uid": {
          ".validate": true
        },
        "t": {
          ".validate": true
        },
        "rua": {
          ".validate": "newData.isString() && newData.val().length <= 48"
        },
        "neg": {
          ".validate": "newData.isString() && newData.val().matches(/^(padaria|lanchonete|mercado|roupas|farmacia|oficina|bar)$/)"
        },
        "$outro": {
          ".validate": false
        }
      }
    }
  }
}